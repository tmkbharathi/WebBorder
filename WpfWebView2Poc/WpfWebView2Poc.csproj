<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="FFmpegDotNet.bin.winx64" Version="9.0.2" />
    <PackageReference Include="FFmpegDotNet._AutoGen" Version="9.0.1" />
    <PackageReference Include="LibVLCSharp" Version="3.10.2" />
    <PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.24" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Samples\Ayyappa.mp4" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Target Name="RemoveFfmpegCommandLineTools" AfterTargets="Build;Publish">
    <Delete Files="$(OutDir)ffmpeg\win-x64\ffmpeg.exe;$(OutDir)ffmpeg\win-x64\ffplay.exe;$(OutDir)ffmpeg\win-x64\ffprobe.exe" />
    <Delete Files="$(PublishDir)ffmpeg\win-x64\ffmpeg.exe;$(PublishDir)ffmpeg\win-x64\ffplay.exe;$(PublishDir)ffmpeg\win-x64\ffprobe.exe" Condition="'$(PublishDir)' != ''" />
  </Target>

</Project>

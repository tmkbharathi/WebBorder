<Window x:Class="WpfWebView2Poc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFmpeg vs VLC Rotation Comparison" Height="760" Width="1320"
        MinHeight="600" MinWidth="900" Background="#F1F5F9"
        WindowStartupLocation="CenterScreen" Loaded="MainWindow_Loaded">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="20" Margin="0,0,0,20" Background="White" CornerRadius="12">
            <StackPanel>
                <TextBlock Text="FFmpeg vs VLC" FontSize="25" FontWeight="Bold" Foreground="#0F172A" />
                <TextBlock Text="Compare the FFmpeg and VLC previews with synchronized rotation and size controls." Margin="0,6,0,18" FontSize="14" Foreground="#64748B" />
                <WrapPanel VerticalAlignment="Center">
                    <Button Content="Choose video…" Click="ChooseVideo_Click" Padding="14,8" Margin="0,0,18,0" />
                    <TextBlock x:Name="VideoNameText" Text="No video selected" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,22,0" />
                    <Button Content="Choose overlay image…" Click="ChooseOverlayImage_Click" Padding="14,8" Margin="0,0,10,0" />
                    <TextBlock x:Name="OverlayImageText" Text="No VLC image" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,18,0" />
                    <Button Content="FFmpeg…" Click="ChooseFfmpeg_Click" Padding="14,8" Margin="0,0,22,0" />
                    <TextBlock x:Name="AudioStatusText" Text="Audio ready" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,18,0" />
                    <TextBlock Text="Rotation" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,10,0" />
                    <Slider x:Name="RotationSlider" Minimum="0" Maximum="360" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" Width="320" VerticalAlignment="Center" ValueChanged="RotationSlider_ValueChanged" />
                    <TextBox x:Name="RotationInput" Text="0" Width="64" Margin="14,0,4,0" Padding="6,5" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" TextChanged="RotationInput_TextChanged" />
                    <TextBlock Text="°" VerticalAlignment="Center" Margin="0,0,16,0" />
                    <Button Content="Apply rotation to both" Click="ApplyRotation_Click" Padding="14,8" Background="#2563EB" Foreground="White" BorderThickness="0" />
                    <TextBlock Text="Preview size" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,8,0" />
                    <TextBox x:Name="WidthInput" Text="0" Width="72" Margin="0,0,4,0" Padding="6,5" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" TextChanged="PreviewSizeInput_TextChanged" ToolTip="Preview width" />
                    <TextBlock Text="×" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <TextBox x:Name="HeightInput" Text="0" Width="72" Margin="0,0,4,0" Padding="6,5" VerticalContentAlignment="Center" HorizontalContentAlignment="Right" TextChanged="PreviewSizeInput_TextChanged" ToolTip="Preview height" />
                    <TextBlock Text="px" VerticalAlignment="Center" Foreground="#64748B" />
                </WrapPanel>
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#0B1220" CornerRadius="12" ClipToBounds="True" Margin="0,0,8,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#172033" Padding="12,8">
                        <TextBlock Text="FFmpeg · rotated preview" Foreground="White" FontWeight="SemiBold" />
                    </Border>
                    <Grid Grid.Row="1" x:Name="VideoSurface" ClipToBounds="True" SizeChanged="VideoSurface_SizeChanged">
                        <TextBlock x:Name="EmptyStateText" Text="Choose a video to begin" Foreground="#CBD5E1" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <Grid x:Name="RotatingFrame" Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Grid.RenderTransform>
                                <RotateTransform x:Name="VideoRotation" Angle="0" />
                            </Grid.RenderTransform>
                            <Image x:Name="VideoFrame" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="1" Background="#0B1220" CornerRadius="12" ClipToBounds="True" Margin="8,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="36" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Background="#172033" Padding="12,8">
                        <DockPanel LastChildFill="False">
                            <TextBlock Text="VLC · decoded frame + image overlay" Foreground="White" FontWeight="SemiBold" />
                            <TextBlock x:Name="VlcStatusText" Text="Waiting for video" Foreground="#CBD5E1" Margin="12,0,0,0" />
                        </DockPanel>
                    </Border>
                    <Grid x:Name="VlcSurface" Grid.Row="1" ClipToBounds="True" SizeChanged="VlcSurface_SizeChanged">
                        <Image x:Name="VlcVideoFrame" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                            <Image.RenderTransform>
                                <RotateTransform x:Name="VlcRotation" Angle="0" />
                            </Image.RenderTransform>
                        </Image>
                        <Image x:Name="VlcOverlayImage" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="18"
                               Width="180" MaxHeight="180" Stretch="Uniform" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

<Window x:Class="WpfWebView2Poc.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        mc:Ignorable="d"
        Title="WPF vs Web HTML/CSS Dynamic TextBox &amp; Border Controller POC" Height="800" Width="1300"
        Background="#F8FAFC"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top Control Toolbar -->
            <RowDefinition Height="Auto" />
            <!-- Main Split View -->
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- TOP CONTROL TOOLBAR -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E8F0" BorderThickness="0,0,0,1" Padding="16,12">
            <WrapPanel VerticalAlignment="Center">
                
                <!-- 1. Text Value Input -->
                <StackPanel Margin="0,0,16,6">
                    <TextBlock Text="Text Value" FontWeight="SemiBold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                    <TextBox x:Name="txtGlobalText" Width="180" Height="30" FontSize="12" Padding="6,2" VerticalContentAlignment="Center" TextChanged="OnGlobalTextChanged" />
                </StackPanel>

                <!-- 2. Border Style Selector -->
                <StackPanel Margin="0,0,16,6">
                    <TextBlock Text="Border Style" FontWeight="SemiBold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox x:Name="cmbBorderStyle" Width="100" Height="30" SelectionChanged="OnParameterChanged" SelectedIndex="0">
                        <ComboBoxItem Content="solid" />
                        <ComboBoxItem Content="dashed" />
                        <ComboBoxItem Content="dotted" />
                    </ComboBox>
                </StackPanel>

                <!-- 3. Border Thickness Slider (1 - 50 px) -->
                <StackPanel Margin="0,0,16,6" Width="150">
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="Thickness" FontWeight="SemiBold" FontSize="11" Foreground="#475569" HorizontalAlignment="Left" />
                        <TextBlock x:Name="lblThicknessVal" Text="{Binding ElementName=sldThickness, Path=Value, StringFormat='{}{0:0} px'}" FontWeight="Bold" FontSize="11" Foreground="#2563EB" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="sldThickness" Minimum="1" Maximum="50" Value="11" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnParameterChanged" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 4. Corner Radius Slider (0 - 40 px) -->
                <StackPanel Margin="0,0,16,6" Width="150">
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="Corner Radius" FontWeight="SemiBold" FontSize="11" Foreground="#475569" HorizontalAlignment="Left" />
                        <TextBlock x:Name="lblRadiusVal" Text="{Binding ElementName=sldRadius, Path=Value, StringFormat='{}{0:0} px'}" FontWeight="Bold" FontSize="11" Foreground="#2563EB" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="sldRadius" Minimum="0" Maximum="40" Value="0" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="OnParameterChanged" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 5. Width Input + Slider (100 - 600 px) -->
                <StackPanel Margin="0,0,16,6" Width="160">
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="Width (px)" FontWeight="SemiBold" FontSize="11" Foreground="#475569" HorizontalAlignment="Left" />
                        <TextBox x:Name="txtWidth" Text="450" Width="45" Height="20" FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="OnNumericInputChanged" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="sldWidth" Minimum="100" Maximum="600" Value="450" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSliderWidthChanged" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 6. Height Input + Slider (30 - 300 px) -->
                <StackPanel Margin="0,0,16,6" Width="160">
                    <Grid Margin="0,0,0,2">
                        <TextBlock Text="Height (px)" FontWeight="SemiBold" FontSize="11" Foreground="#475569" HorizontalAlignment="Left" />
                        <TextBox x:Name="txtHeight" Text="150" Width="45" Height="20" FontSize="11" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="OnNumericInputChanged" HorizontalAlignment="Right" />
                    </Grid>
                    <Slider x:Name="sldHeight" Minimum="30" Maximum="300" Value="150" TickFrequency="5" IsSnapToTickEnabled="True" ValueChanged="OnSliderHeightChanged" VerticalAlignment="Center" />
                </StackPanel>

                <!-- 7. Border Color Selector -->
                <StackPanel Margin="0,0,10,6">
                    <TextBlock Text="Border Color" FontWeight="SemiBold" FontSize="11" Foreground="#475569" Margin="0,0,0,4" />
                    <ComboBox x:Name="cmbBorderColor" Width="120" Height="30" SelectionChanged="OnParameterChanged" SelectedIndex="0">
                        <ComboBoxItem Tag="#3B82F6" Content="Blue (#3B82F6)" />
                        <ComboBoxItem Tag="#10B981" Content="Green (#10B981)" />
                        <ComboBoxItem Tag="#EF4444" Content="Red (#EF4444)" />
                        <ComboBoxItem Tag="#8B5CF6" Content="Purple (#8B5CF6)" />
                        <ComboBoxItem Tag="#F59E0B" Content="Amber (#F59E0B)" />
                        <ComboBoxItem Tag="#0F172A" Content="Dark (#0F172A)" />
                    </ComboBox>
                </StackPanel>

            </WrapPanel>
        </Border>

        <!-- MAIN SPLIT VIEW -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Left Half: WebView2 -->
                <ColumnDefinition Width="*" />
                <!-- Splitter Line -->
                <ColumnDefinition Width="2" />
                <!-- Right Half: WPF Native -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- LEFT HALF: WebView2 Control -->
            <Border Grid.Column="0" Margin="0" Background="#F8FAFC" ClipToBounds="True">
                <wv2:WebView2 x:Name="webView" />
            </Border>

            <!-- SPLITTER -->
            <GridSplitter Grid.Column="1" Width="2" HorizontalAlignment="Stretch" Background="#E2E8F0" />

            <!-- RIGHT HALF: Native WPF Control (Straight Alignment to Web View) -->
            <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <Grid Margin="24">
                    <StackPanel HorizontalAlignment="Stretch">
                        
                        <!-- Header Matching Web View HTML Header Exactly -->
                        <Border BorderBrush="#E2E8F0" BorderThickness="0,0,0,2" Margin="0,0,0,20" Padding="0,0,0,8" Height="32">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="#8B5CF6" CornerRadius="12" Padding="8,4" Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock Text="NATIVE WPF" Foreground="White" FontSize="11" FontWeight="Bold" />
                                </Border>
                                <TextBlock Text="WPF Dynamic Native Controls" FontSize="18" FontWeight="Bold" Foreground="#1E293B" VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- Outer Card Matching .input-card CSS -->
                        <Border Background="#FFFFFF"
                                CornerRadius="12"
                                Padding="24"
                                BorderBrush="#E2E8F0"
                                BorderThickness="1"
                                HorizontalAlignment="Stretch">
                            <Border.Effect>
                                <DropShadowEffect Color="#000000" BlurRadius="6" ShadowDepth="1" Opacity="0.04" />
                            </Border.Effect>

                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Live WPF Textbox Element:" FontWeight="SemiBold" FontSize="14" Foreground="#334155" Height="20" Margin="0,0,0,12" HorizontalAlignment="Left" />

                                <!-- Host Container Grid hosting Border or Rectangle based on Style selection -->
                                <Grid x:Name="wpfHostGrid" Width="450" Height="150" HorizontalAlignment="Center">
                                    <!-- Solid Border Component -->
                                    <Border x:Name="wpfSolidBorder"
                                            Background="#FFFFFF"
                                            BorderBrush="#3B82F6"
                                            BorderThickness="2"
                                            CornerRadius="0"
                                            Visibility="Visible" />

                                    <!-- Dashed/Dotted Rectangle Component -->
                                    <Rectangle x:Name="wpfDashedDottedRect"
                                               Fill="#FFFFFF"
                                               Stroke="#3B82F6"
                                               StrokeThickness="2"
                                               RadiusX="0" RadiusY="0"
                                               Visibility="Collapsed" />

                                    <!-- Dynamic Overlay TextBox supporting multiline input -->
                                    <TextBox x:Name="wpfDynamicTextBox"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             FontSize="15"
                                             Foreground="#0F172A"
                                             VerticalContentAlignment="Top"
                                             AcceptsReturn="True"
                                             TextWrapping="Wrap"
                                             Margin="2"
                                             Padding="10,8"
                                             TextChanged="WpfInput_TextChanged" />
                                </Grid>

                                <!-- Specs Panel Matching .specs-panel CSS -->
                                <Border Margin="0,20,0,0" Background="#F1F5F9" CornerRadius="8" Padding="12,16" HorizontalAlignment="Stretch">
                                    <StackPanel TextElement.FontFamily="Consolas" TextElement.FontSize="12">
                                        <StackPanel Orientation="Horizontal" Height="18" Margin="0,2">
                                            <TextBlock Text="border-style: " Foreground="#475569" />
                                            <TextBlock x:Name="txtWpfSpecStyle" Text="dashed" FontWeight="Bold" Foreground="#2563EB" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Height="18" Margin="0,2">
                                            <TextBlock Text="border-width: " Foreground="#475569" />
                                            <TextBlock x:Name="txtWpfSpecThickness" Text="11px" FontWeight="Bold" Foreground="#2563EB" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Height="18" Margin="0,2">
                                            <TextBlock Text="width: " Foreground="#475569" />
                                            <TextBlock x:Name="txtWpfSpecWidth" Text="450px" FontWeight="Bold" Foreground="#2563EB" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Height="18" Margin="0,2">
                                            <TextBlock Text="height: " Foreground="#475569" />
                                            <TextBlock x:Name="txtWpfSpecHeight" Text="150px" Foreground="#2563EB" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Height="18" Margin="0,2">
                                            <TextBlock Text="border-color: " Foreground="#475569" />
                                            <TextBlock x:Name="txtWpfSpecColor" Text="#3B82F6" FontWeight="Bold" Foreground="#2563EB" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Height="18" Margin="0,2">
                                            <TextBlock Text="border-radius: " Foreground="#475569" />
                                            <TextBlock x:Name="txtWpfSpecRadius" Text="0px" FontWeight="Bold" Foreground="#2563EB" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
